# Copy to .env and adjust if needed.
# Used by Prisma (packages/database) and the Next.js app.

DATABASE_URL="postgresql://cosmic:cosmic@localhost:5432/cosmic_gateway?schema=public"

# Public site URL (used later for OG/sitemap; optional locally)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin auth — leave AUTH_SECRET / passwords empty for open local admin in development.
# Production requires AUTH_SECRET + ADMIN_PASSWORD_HASH (preferred) or ADMIN_PASSWORD.
# Generate hash + secret: node scripts/hash-admin-password.mjs "your-password"
AUTH_SECRET=
ADMIN_USERNAME=admin
# Prefer ADMIN_PASSWORD_HASH (scrypt$...). Docker Compose may warn about `$`
# in this file; that is harmless for our compose.yml — keep single `$` for Next.js.
ADMIN_PASSWORD_HASH=
# Legacy local convenience (plaintext). Prefer ADMIN_PASSWORD_HASH.
ADMIN_PASSWORD=

# Preview deployments block admin writes unless explicitly allowed
ALLOW_ADMIN_WRITES_ON_PREVIEW=false
